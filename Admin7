
<script>
const pages = {
    overview: ['Dashboard Overview', "Here's what's happening at your institution today."],
    people: ['Students & Staff', 'Manage and review student and staff accounts.'],
    departments: ['Departments & Classes', 'Compare enrolment and department information.'],
    attendance: ['Attendance Management', 'Review attendance summaries and records.'],
    complaints: ['Complaint Center', 'Review and resolve student and staff complaints.'],
    reports: ['Reports & Analytics', 'Explore trends and prepare attendance reports.'],
    notifications: ['Notifications & Alerts', 'Review important system updates.'],
    settings: ['Settings & Audit Logs', 'Manage rules and track administrative changes.']
};

function showPage(id) {
    document.querySelectorAll('.page').forEach(x => x.classList.remove('active'));
    document.getElementById(id).classList.add('active');

    document.querySelectorAll('.navlink[data-page]').forEach(x =>
        x.classList.toggle('active', x.dataset.page === id)
    );

    document.getElementById('pageTitle').textContent = pages[id][0];
    document.getElementById('pageSubtitle').textContent = pages[id][1];

    toggleMenu(false);
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.querySelectorAll('.navlink[data-page]').forEach(a =>
    a.onclick = () => showPage(a.dataset.page)
);

function toggleMenu(open) {
    document.getElementById('sidebar').classList.toggle('open', open);
    document.getElementById('overlay').classList.toggle('show', open);
}

Chart.defaults.color = '#9298a7';
Chart.defaults.font.family = 'system-ui';

const trend = new Chart(document.getElementById('trend'), {
    type: 'line',
    data: {
        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
        datasets: [{
            data: [84, 88, 82, 91, 87, 94, 88],
            borderColor: '#5b72f5',
            backgroundColor: 'rgba(91,114,245,.12)',
            fill: true,
            tension: .4,
            borderWidth: 3,
            pointRadius: 3
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            y: {
                min: 60,
                max: 100,
                ticks: { callback: v => v + '%' },
                grid: { color: '#f0f1f7' }
            },
            x: { grid: { display: false } }
        }
    }
});

function updateTrend() {
    let m = document.getElementById('range').value === 'month';

    trend.data.labels = m
        ? ['1–5', '6–10', '11–15', '16–20', '21–25', '26–30']
        : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

    trend.data.datasets[0].data = m
        ? [81, 85, 83, 89, 86, 88]
        : [84, 88, 82, 91, 87, 94];

    trend.update();
}

new Chart(document.getElementById('donut'), {
    type: 'doughnut',
    data: {
        labels: ['Present', 'Absent', 'Late', 'Excused'],
        datasets: [{
            data: [1086, 154, 32, 18],
            backgroundColor: ['#5277f5', '#a65be8', '#f4ae52', '#31b88a'],
            borderWidth: 0
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '72%',
        plugins: { legend: { display: false } }
    }
});

const depts = [
    ['CME', 340, 12, 91],
    ['ECE', 290, 10, 86],
    ['EEE', 220, 8, 84],
    ['Mechanical', 210, 9, 82],
    ['Civil', 180, 9, 89]
];

new Chart(document.getElementById('bars'), {
    type: 'bar',
    data: {
        labels: depts.map(d => d[0]),
        datasets: [{
            data: depts.map(d => d[1]),
            backgroundColor: ['#5b78f5', '#8c5cf0', '#b06be8', '#f0a04a', '#36b997'],
            borderRadius: 7,
            maxBarThickness: 36
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            y: { grid: { color: '#f0f1f7' } },
            x: { grid: { display: false } }
        }
    }
});

const hm = document.getElementById('heatmap');

['M', 'T', 'W', 'T', 'F', 'S', 'S'].forEach(x =>
    hm.insertAdjacentHTML('beforeend', `<div class="weekday">${x}</div>`)
);

for (let i = 0; i < 28; i++) {
    hm.insertAdjacentHTML('beforeend', '<span title="Sample attendance activity"></span>');
}

function safe(s) {
    return String(s).replace(/[&<>"']/g, c => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    }[c]));
}

document.getElementById('deptList').innerHTML = depts.map(d => `
    <div class="deptrow">
        <span>${d[0]}</span>
        <div class="progress">
            <div class="progress-bar" style="width:${d[1] / 340 * 100}%"></div>
        </div>
        <strong>${d[1]}</strong>
    </div>
`).join('');

document.getElementById('departmentRows').innerHTML = depts.map(d => `
    <tr>
        <td><b>${d[0]}</b></td>
        <td>${d[1]}</td>
        <td>${d[2]}</td>
        <td>${d[3]}%</td>
        <td>
            <span class="badge-soft ${d[3] < 85 ? 'open' : 'resolved'}">
                ${d[3] < 85 ? 'Review' : 'On track'}
            </span>
        </td>
    </tr>
`).join('');

let people = [
    ['Aarav Kumar', 'ST1024', 'Student', 'CME'],
    ['Ananya Rao', 'ST1025', 'Student', 'ECE'],
    ['Ravi Teja', 'SF0048', 'Staff', 'CME'],
    ['Meghana Das', 'ST1026', 'Student', 'EEE'],
    ['Sana Ali', 'SF0049', 'Staff', 'Civil']
];

function renderPeople() {
    let q = (document.getElementById('search').value || '').toLowerCase();
    let role = document.getElementById('role').value;

    let rows = people.filter(p =>
        (role === 'All' || p[2] === role) &&
        p.join(' ').toLowerCase().includes(q)
    );

    document.getElementById('peopleRows').innerHTML =
        rows.map(p => `
            <tr>
                <td><b>${safe(p[0])}</b></td>
                <td>${p[1]}</td>
                <td>${p[2]}</td>
                <td>${p[3]}</td>
                <td><span class="badge-soft resolved">Active</span></td>
            </tr>
        `).join('') ||
        '<tr><td colspan="5">No matching people found.</td></tr>';
}

let complaints = [
    {id:1, title:'Attendance not updated', role:'Student', by:'ST1024', cat:'Attendance', date:'30 Oct 2026', status:'Open'},
    {id:2, title:'Unable to view class list', role:'Staff', by:'SF0048', cat:'Access issue', date:'30 Oct 2026', status:'In Progress'},
    {id:3, title:'Incorrect attendance entry', role:'Student', by:'ST1025', cat:'Attendance', date:'29 Oct 2026', status:'Open'},
    {id:4, title:'Request to update timetable', role:'Staff', by:'SF0049', cat:'Timetable', date:'29 Oct 2026', status:'Resolved'},
    {id:5, title:'Report download issue', role:'Staff', by:'SF0050', cat:'Reports', date:'28 Oct 2026', status:'Open'},
    {id:6, title:'Profile details correction', role:'Student', by:'ST1032', cat:'Profile', date:'28 Oct 2026', status:'In Progress'}
];

function statusClass(s) {
    return s === 'Resolved' ? 'resolved'
        : s === 'In Progress' ? 'progressing'
        : 'open';
}

function renderComplaints() {
    let role = document.getElementById('complaintRole')?.value || 'All';
    let st = document.getElementById('complaintStatus')?.value || 'All';

    let list = complaints.filter(c =>
        (role === 'All' || c.role === role) &&
        (st === 'All' || c.status === st)
    );

    document.getElementById('complaintRows').innerHTML =
        list.map(c => `
            <tr>
                <td><b>${safe(c.title)}</b></td>
                <td>
                    <span class="badge-soft ${c.role === 'Student' ? 'progressing' : 'open'}">${c.role}</span>
                    <div class="hint">${c.by}</div>
                </td>
                <td>${c.cat}</td>
                <td>${c.date}</td>
                <td><span class="badge-soft ${statusClass(c.status)}">${c.status}</span></td>
                <td>
                    ${c.status === 'Resolved'
                        ? 'Done'
                        : `<button class="outline" onclick="advance(${c.id})">
                            ${c.status === 'Open' ? 'Start review' : 'Resolve'}
                           </button>`
                    }
                </td>
            </tr>
        `).join('') ||
        '<tr><td colspan="6">No matching complaints.</td></tr>';

    document.getElementById('overviewComplaints').innerHTML =
        complaints.filter(c => c.status !== 'Resolved').slice(0, 3).map(c => `
            <div class="activity">
                <div class="staticon ${c.role === 'Student' ? 'blue' : 'purple'}">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="desc">${safe(c.title)}</div>
                    <small>${c.role} · ${c.by} · ${c.date}</small>
                </div>
                <span class="badge-soft ${statusClass(c.status)}">${c.status}</span>
            </div>
        `).join('');
}

function advance(id) {
    let c = complaints.find(c => c.id === id);
    c.status = c.status === 'Open' ? 'In Progress' : 'Resolved';
    renderComplaints();
}

function addPerson() {
    let name = document.getElementById('newName').value.trim();

    if (!name) {
        alert('Enter a name first.');
        return;
    }

    let role = document.getElementById('newRole').value;
    let dept = document.getElementById('newDept').value;

    people.push([
        name,
        (role === 'Student' ? 'ST' : 'SF') + (1030 + people.length),
        role,
        dept
    ]);

    renderPeople();

    bootstrap.Modal.getInstance(
        document.getElementById('addModal')
    ).hide();

    alert('Added to this browser preview only. Connect Django/MySQL to save permanently.');
}

renderPeople();
renderComplaints();
</script>

</body>
</html>
