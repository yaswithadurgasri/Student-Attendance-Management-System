
<!-- STUDENTS & STAFF PAGE -->

<section class="page" id="people">

 <div class="panel">

  <div class="panelhead flex-wrap">

   <div>
    <h3>Students &amp; Staff</h3>

    <div class="hint">
     Search and review institution accounts.
    </div>
   </div>

   <button class="gradient"
    data-bs-toggle="modal"
    data-bs-target="#addModal">
    + Add person
   </button>

  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">

   <input id="search"
    class="search"
    placeholder="Search name, ID or department..."
    oninput="renderPeople()">

   <select id="role"
    class="form-select"
    style="width:auto"
    onchange="renderPeople()">

    <option value="All">All roles</option>
    <option>Student</option>
    <option>Staff</option>

   </select>

  </div>

  <div class="table-responsive">

   <table class="table">

    <thead>
     <tr>
      <th>Name</th>
      <th>ID</th>
      <th>Role</th>
      <th>Department</th>
      <th>Status</th>
     </tr>
    </thead>

    <tbody id="peopleRows"></tbody>

   </table>

  </div>

 </div>

</section>


<!-- DEPARTMENTS & CLASSES PAGE -->

<section class="page" id="departments">

 <div class="panel">

  <h3>Departments &amp; Classes</h3>

  <div class="hint mb-3">
   Compare enrolment and identify departments
   with more or fewer students.
  </div>

  <div class="table-responsive">

   <table class="table">

    <thead>
     <tr>
      <th>Department</th>
      <th>Students</th>
      <th>Staff</th>
      <th>Attendance rate</th>
      <th>Attention</th>
     </tr>
    </thead>

    <tbody id="departmentRows"></tbody>

   </table>

  </div>

 </div>

</section>


<!-- ATTENDANCE MANAGEMENT PAGE -->

<section class="page" id="attendance">

 <div class="panel">

  <h3>Attendance Management</h3>

  <div class="hint mb-3">
   Review daily attendance summary.
   Real records must be loaded from Django/MySQL.
  </div>

  <div class="row g-3">

   <div class="col-6 col-lg-3">

    <div class="stat">

     <div class="stathead">Present</div>

     <div class="number">1,086</div>

    </div>

   </div>

   <div class="col-6 col-lg-3">

    <div class="stat">

     <div class="stathead">Absent</div>

     <div class="number">154</div>

    </div>

   </div>

   <div class="col-6 col-lg-3">

    <div class="stat">

     <div class="stathead">Late</div>

     <div class="number">32</div>

    </div>

   </div>

   <div class="col-6 col-lg-3">

    <div class="stat">

     <div class="stathead">Excused</div>

     <div class="number">18</div>

    </div>

   </div>

  </div>

  <p class="hint mt-3">
   Sample data only. Attendance corrections should
   be permission-checked and logged.
  </p>

 </div>

</section>
