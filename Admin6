
<section class="page" id="reports">
    <div class="panel">
        <div class="panelhead">
            <div>
                <h3>Reports &amp; Analytics</h3>
                <div class="hint">Print this preview or save as PDF. Connect real reports through Django.</div>
            </div>
            <button class="gradient" onclick="window.print()">
                <i class="bi bi-download me-1"></i>Print / Save PDF
            </button>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="stat">
                    <div class="stathead">Overall attendance</div>
                    <div class="number">87.6%</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat">
                    <div class="stathead">Departments tracked</div>
                    <div class="number">5</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="page" id="notifications">
    <div class="panel">
        <h3>Notifications &amp; Alerts</h3>

        <div class="activity">
            <span class="staticon orange">
                <i class="bi bi-exclamation-circle"></i>
            </span>
            <div>
                <div class="desc">Low attendance needs review</div>
                <small>Set an attendance threshold and alert authorized staff.</small>
            </div>
        </div>

        <div class="activity">
            <span class="staticon purple">
                <i class="bi bi-chat-square-text"></i>
            </span>
            <div>
                <div class="desc">6 complaints awaiting review</div>
                <small>Open Complaint Center to separate student and staff complaints.</small>
            </div>
        </div>
    </div>
</section>

<section class="page" id="settings">
    <div class="panel">
        <h3>Settings &amp; Audit Logs</h3>
        <div class="hint mb-3">Configure rules and track administrative changes.</div>

        <form onsubmit="event.preventDefault();alert('Demo only. Connect settings to a protected Django form.')" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Low attendance threshold (%)</label>
                <input type="number" class="form-control" min="1" max="100" value="75">
            </div>

            <div class="col-md-6">
                <label class="form-label">Institution name</label>
                <input class="form-control" value="SmartAttend Institution">
            </div>

            <div class="col-12">
                <button class="gradient">Save settings</button>
            </div>
        </form>

        <hr>

        <h3>Audit log preview</h3>

        <div class="activity">
            <div>
                <div class="desc">Dashboard viewed</div>
                <small>Admin · Today</small>
            </div>
        </div>

        <div class="activity">
            <div>
                <div class="desc">Complaint status updated (demo)</div>
                <small>Admin · Today</small>
            </div>
        </div>
    </div>
</section>

<footer class="text-center small mt-4" style="color:#a0a5b2">
    © 2026 SmartAttend · Admin Dashboard Preview
</footer>
</main>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header border-0">
                <h5 class="modal-title">Add person (demo)</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Full name</label>
                <input id="newName" class="form-control mb-3" placeholder="Enter full name">

                <label class="form-label">Role</label>
                <select id="newRole" class="form-select mb-3">
                    <option>Student</option>
                    <option>Staff</option>
                </select>

                <label class="form-label">Department</label>
                <select id="newDept" class="form-select">
                    <option>CME</option>
                    <option>ECE</option>
                    <option>EEE</option>
                    <option>Mechanical</option>
                    <option>Civil</option>
                </select>
            </div>

            <div class="modal-footer border-0">
                <button class="outline" data-bs-dismiss="modal">Cancel</button>
                <button class="gradient" onclick="addPerson()">Add to preview</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
