
<body>

<div class="overlay" id="overlay" onclick="toggleMenu(false)"></div>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">

 <div class="brand">
  <div class="logo">
   <i class="bi bi-mortarboard-fill"></i>
  </div>
  <span>Smart<span style="color:#7654ef">Attend</span></span>
 </div>

 <div class="nav-label">WORKSPACE</div>

 <a class="navlink active" data-page="overview">
  <i class="bi bi-grid-1x2-fill"></i>Overview
 </a>

 <a class="navlink" data-page="people">
  <i class="bi bi-people"></i>Students &amp; Staff
 </a>

 <a class="navlink" data-page="departments">
  <i class="bi bi-diagram-3"></i>Departments &amp; Classes
 </a>

 <a class="navlink" data-page="attendance">
  <i class="bi bi-calendar2-check"></i>Attendance Management
 </a>

 <div class="nav-label">MANAGEMENT</div>

 <a class="navlink" data-page="complaints">
  <i class="bi bi-chat-square-text"></i>Complaints
  <span class="badge rounded-pill ms-auto"
   style="background:#fff0df;color:#bd741b">6</span>
 </a>

 <a class="navlink" data-page="reports">
  <i class="bi bi-bar-chart-line"></i>Reports &amp; Analytics
 </a>

 <a class="navlink" data-page="notifications">
  <i class="bi bi-bell"></i>Notifications
 </a>

 <div class="nav-label">SYSTEM</div>

 <a class="navlink" data-page="settings">
  <i class="bi bi-sliders"></i>Settings &amp; Audit Logs
 </a>

 <div class="mt-4 p-3 rounded-4"
  style="background:#f7f8ff;color:#73798b;font-size:12px">

  <b>
   <i class="bi bi-shield-check me-2 text-primary"></i>
   Admin workspace
  </b>

  <div class="mt-2">
   Manage attendance and resolve issues in one place.
  </div>

 </div>

 <a class="navlink mt-3" href="login.html">
  <i class="bi bi-box-arrow-left"></i>Log out
 </a>

</aside>

<!-- MAIN CONTENT -->
<main class="main">

<!-- DASHBOARD HEADER -->
<header class="topbar">

 <div class="d-flex gap-3 align-items-start">

  <button class="iconbtn mobiletoggle"
   onclick="toggleMenu(true)">
   <i class="bi bi-list fs-5"></i>
  </button>

  <div>
   <h1 class="title" id="pageTitle">
    Dashboard Overview
   </h1>

   <div class="muted" id="pageSubtitle">
    Here's what's happening at your institution today.
   </div>
  </div>

 </div>

 <div class="d-flex align-items-center gap-2">

  <button class="iconbtn"
   onclick="showPage('notifications')">
   <i class="bi bi-bell"></i>
  </button>

  <div class="admin">
   <div class="avatar">A</div>
   <span class="adminlabel">Admin</span>
  </div>

 </div>

</header>

<!-- OVERVIEW PAGE -->
<section class="page active" id="overview">

 <div class="welcome">

  <div>

   <h2>Welcome back, Admin ✨</h2>

   <p>
    Track attendance, explore department trends
    and manage complaints.
   </p>

   <div class="mt-3 d-flex gap-2 flex-wrap">

    <button class="gradient"
     onclick="showPage('reports')">
     View reports
    </button>

    <button class="outline"
     onclick="showPage('complaints')">
     Review complaints
    </button>

   </div>

  </div>

  <div class="welcome-icon">
   <i class="bi bi-mortarboard"></i>
  </div>

 </div>

<!-- STATISTICS CARDS -->

<div class="row g-3">

 <div class="col-6 col-xl-3">
  <div class="stat">

   <div class="stathead">
    Total Students
    <span class="staticon blue">
     <i class="bi bi-people"></i>
    </span>
   </div>

   <div class="number">1,240</div>

   <div class="sub">
    Across all departments
   </div>

  </div>
 </div>

 <div class="col-6 col-xl-3">
  <div class="stat">

   <div class="stathead">
    Present Today
    <span class="staticon green">
     <i class="bi bi-person-check"></i>
    </span>
   </div>

   <div class="number">1,086</div>

   <div class="sub" style="color:#159d6d">
    87.6% attendance rate
   </div>

  </div>
 </div>

 <div class="col-6 col-xl-3">
  <div class="stat">

   <div class="stathead">
    Absent Today
    <span class="staticon orange">
     <i class="bi bi-person-x"></i>
    </span>
   </div>

   <div class="number">154</div>

   <div class="sub">
    Review absence records
   </div>

  </div>
 </div>

 <div class="col-6 col-xl-3">
  <div class="stat">

   <div class="stathead">
    Total Staff
    <span class="staticon purple">
     <i class="bi bi-person-workspace"></i>
    </span>
   </div>

   <div class="number">48</div>

   <div class="sub">
    Across all departments
   </div>

  </div>
 </div>

</div>

<!-- ATTENDANCE ANALYTICS -->

<div class="section-title">
 Attendance analytics
</div>

<div class="row g-3">

 <!-- ATTENDANCE TREND -->
 <div class="col-12 col-xl-8">

  <div class="panel">

   <div class="panelhead">

    <div>
     <h3>Attendance Trends</h3>
     <div class="hint">
      Attendance rate over time
     </div>
    </div>

    <select class="form-select"
     style="width:auto;font-size:11px"
     id="range"
     onchange="updateTrend()">

     <option value="week">Last 7 days</option>
     <option value="month">Last 30 days</option>

    </select>

   </div>

   <div class="chart">
    <canvas id="trend"></canvas>
   </div>

  </div>

 </div>

 <!-- ATTENDANCE DISTRIBUTION -->
 <div class="col-12 col-xl-4">

  <div class="panel">

   <div class="panelhead">

    <div>
     <h3>Attendance Distribution</h3>

     <div class="hint">
      Today's recorded status
     </div>
    </div>

   </div>

   <div class="chart donut">
    <canvas id="donut"></canvas>
   </div>

   <div class="text-center small text-secondary">
    Present · Absent · Late · Excused
   </div>

  </div>

 </div>

 <!-- DEPARTMENT COMPARISON -->
 <div class="col-12 col-xl-6">

  <div class="panel">

   <div class="panelhead">

    <div>
     <h3>Department Comparison</h3>

     <div class="hint">
      Student count by department
     </div>
    </div>

   </div>

   <div class="chart">
    <canvas id="bars"></canvas>
   </div>

  </div>

 </div>

 <!-- ATTENDANCE HEATMAP -->
 <div class="col-12 col-xl-6">

  <div class="panel">

   <div class="panelhead">

    <div>
     <h3>Attendance Heatmap</h3>

     <div class="hint">
      Illustrative activity pattern · 4 weeks
     </div>
    </div>

   </div>

   <div class="heatmap" id="heatmap"></div>

   <div class="text-end mt-2 small text-secondary">
    Lower activity → Higher activity
   </div>

  </div>

 </div>

</div>
