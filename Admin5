
<section class="page" id="complaints">
    <div class="panel">
        <div class="panelhead flex-wrap">
            <div>
                <h3>Complaint Center</h3>
                <div class="hint">View student and staff complaints separately and track resolution.</div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select id="complaintRole" class="form-select" style="width:auto" onchange="renderComplaints()">
                    <option>All</option>
                    <option>Student</option>
                    <option>Staff</option>
                </select>

                <select id="complaintStatus" class="form-select" style="width:auto" onchange="renderComplaints()">
                    <option>All</option>
                    <option>Open</option>
                    <option>In Progress</option>
                    <option>Resolved</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Complaint</th>
                        <th>Submitted by</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="complaintRows"></tbody>
            </table>
        </div>

        <div class="hint mt-3">
            Demo status changes only affect this browser preview. Use Django to save changes permanently.
        </div>
    </div>
</section>
